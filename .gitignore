# ============================
# Root-level
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db

# Session/troubleshooting leftovers — not project files
filestructure.txt
session_changes.patch
session_full_diff.patch
*.patch

# ============================
# Backend
# ============================
# Environment
backend/.env
backend/.env.local
backend/.env.production

# Node / dependencies (package-lock.json IS committed on purpose - reproducible installs)
backend/node_modules/

# Uploaded files (keep only .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Test files (optional if you don't want them in repo)
backend/test/*.test.js
backend/test/setup.js

# Deployment / build artifacts
backend/.codeviz/
backend/deployment_guide/
backend/features.txt
backend/flow.txt
backend/flow_done.txt
backend/workspace_feature.txt
backend/AUDIT_REPORT.md
backend/FIXES_APPLIED.md
backend/HEALTH_REPORT.md

# ============================
# Frontend
# ============================
# Environment
frontend/.env.development
frontend/.env.production
frontend/.env.backup
frontend/.env.*.local

# Node / dependencies (package-lock.json IS committed on purpose - reproducible installs)
frontend/node_modules/

# Build / output
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vercel/

# Test files
frontend/src/App.test.js
frontend/src/setupTests.js

# Editor / OS junk
frontend/.vscode/
frontend/.idea/

